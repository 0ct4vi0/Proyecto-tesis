# Tipo de conexión GMP: "tls" (puerto 9390) o "socket" (unix socket de gvmd)
GVM_CONN_TYPE=tls

# Usado si GVM_CONN_TYPE=tls
GVM_HOST=openvas
GVM_PORT=9390

# Usado si GVM_CONN_TYPE=socket (montar el volumen del socket de gvmd)
GVM_SOCKET_PATH=/run/gvmd/gvmd.sock

# Credenciales del usuario GMP (NUNCA hardcodear en código ni en docs)
GVM_USERNAME=admin
GVM_PASSWORD=changeme
