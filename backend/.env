# Tipo de conexión GMP: "tls" (puerto 9390) o "socket" (unix socket de gvmd)
GVM_CONN_TYPE=socket

# Usado si GVM_CONN_TYPE=tls
GVM_HOST=openvas
GVM_PORT=9390

# Usado si GVM_CONN_TYPE=socket (montar el volumen del socket de gvmd)
GVM_SOCKET_PATH=/run/gvmd/gvmd.sock

# Credenciales del usuario GMP (NUNCA hardcodear en código ni en docs)
GVM_USERNAME=admin
GVM_PASSWORD=12345

#(ajustá usuario, clave y puerto a los de tu docker-compose de Postgres)
DATABASE_URL=postgresql://postgres:123456@localhost:5432/db_tesis

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=raU1RoU8nQTbNUxYHBEvLsS-JYnaceY-Ws6-s9JnvPEZ5P9ft7-pFgyRKwgA8bBm
JWT_EXPIRE_HOURS=8

# Client ID de Google Cloud Console (público). Si queda vacío, /auth/google responde 503.
GOOGLE_CLIENT_ID=818117305221-uknsrerhvn4vomnre2mel67p1d9s3j5h.apps.googleusercontent.com